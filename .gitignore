# ReCollect_SecondBrain: the MCP server and agent skills, the design specs, and the Android companion.
# The apps are their own repos (recollect/ = ReCollect, backend/ = ReCollect_Backend) and stay out of this one.
# Everything at the root is ignored unless it is listed here.
/*
!/.gitignore
!/README.md
!/LICENSE
!/context/
!/mcp/
!/prototype/
!/android/

# Kept on this PC only: personal planning, research and notes (the history before 2026-11-15 is in
# .private/ as a git bundle, never pushed).
/context/HISTORY.md
/context/research/
/context/archive/
/context/specs/BUDDY_PLAN.md
/context/specs/BUDDY_MEMORY_PLAN.md
/context/specs/HOSTING_PREP_PLAN.md
/context/specs/ECOSYSTEM_V2_PLAN.md
/context/specs/MCP_MEMORY_PLAN.md
/context/specs/SIMULATION_PLAN.md
/context/specs/PHONE_APP_REDESIGN_PLAN.md
/context/specs/WHERE_YOU_STAND_PLAN.md
/context/specs/HOME_DOCS_AGENT_PLAN.md
/context/specs/PERSONAL_OFFICE_PLAN.md
/context/specs/EASY_SETUP_PLAN.md

# The Android app's build tools, outputs and signing key
/android/.toolchain/
/android/build/
/android/keys/
# editor help that names this computer's SDK path
/android/.classpath
/android/.project
/android/.settings/
*.keystore
*.jks
*.apk

node_modules/
dist/
dist-next/
*.stackdump
.env
.env.*
*.log
