{
  "name": "kaaga-setup",
  "version": "0.5.0",
  "description": "Kaaga for your AI coding tools: `npx kaaga-setup` signs this computer in (you approve it in your browser) and adds Kaaga's tools, hooks and skills to Claude Code, Antigravity and Cursor.",
  "keywords": [
    "kaaga",
    "mcp",
    "claude-code",
    "antigravity",
    "cursor",
    "learning",
    "work-log"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "kaaga-setup": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:smoke": "npm run build && vitest run --config vitest.smoke.config.ts",
    "start": "node dist/index.js",
    "install:skill": "node scripts/install-skill.mjs",
    "install:hooks": "node scripts/install-hooks.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
