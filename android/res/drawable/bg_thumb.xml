<?xml version="1.0" encoding="utf-8"?>
<!-- A thumb: a round soft button; the accent's soft fill once given. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/press">
    <item>
        <selector>
            <item android:state_selected="true"><shape android:shape="oval"><solid android:color="@color/accent_soft" /></shape></item>
            <item><shape android:shape="oval"><solid android:color="@color/surface_2" /></shape></item>
        </selector>
    </item>
</ripple>
