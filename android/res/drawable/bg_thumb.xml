<?xml version="1.0" encoding="utf-8"?>
<!-- A thumb button (the web card's small icon button): clear, the selected fill once given, a press ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/press">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/surface_2" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#00000000" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
