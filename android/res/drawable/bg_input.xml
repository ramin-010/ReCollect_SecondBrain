<?xml version="1.0" encoding="utf-8"?>
<!-- "Tell your buddy": a soft pill; the accent ring while it has focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><corners android:radius="23dp" /><solid android:color="@color/surface_2" /><stroke android:width="1.5dp" android:color="@color/accent_fill" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="23dp" /><solid android:color="@color/surface_2" /></shape>
    </item>
</selector>
