<?xml version="1.0" encoding="utf-8"?>
<!-- A text field (the web app's rc-input): its own fill, a 1 dp ring, the accent ring while typing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/surface" />
            <stroke android:width="1.5dp" android:color="@color/accent_fill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/line_strong" />
        </shape>
    </item>
</selector>
