<?xml version="1.0" encoding="utf-8"?>
<!-- The chosen segment is dark (DESIGN.md "segmented-chosen"); the others fill when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle"><corners android:radius="6dp" /><solid android:color="@color/main" /></shape>
    </item>
    <item>
        <ripple android:color="@color/press">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle"><corners android:radius="6dp" /><solid android:color="#FFFFFFFF" /></shape>
            </item>
        </ripple>
    </item>
</selector>
