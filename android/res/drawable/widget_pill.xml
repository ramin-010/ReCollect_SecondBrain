<?xml version="1.0" encoding="utf-8"?>
<!-- Later on the widget (0.7.0): an outlined pill, pressed with the set colour. widget-themes.py makes the copies. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/w_set" />
            <stroke android:width="1.5dp" android:color="@color/w_line_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="@color/w_line_strong" />
        </shape>
    </item>
</selector>
