<?xml version="1.0" encoding="utf-8"?>
<!-- A row inside a card: no fill of its own, a press ripple to the card's edge. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/press">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /></shape>
    </item>
</ripple>
