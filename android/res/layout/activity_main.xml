<?xml version="1.0" encoding="utf-8"?>
<!--
  The one screen (ANDROID_APP_SPEC "Settings"; 0.4.0: a product's look). Its job: hear from the buddy,
  see the picture of the day and choose where and how it shows. Three states share it: not connected,
  a connect link arrived, connected. Cards on a calm page, Inter throughout, one accent for what is on.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="30dp"
        android:paddingEnd="18dp"
        android:paddingBottom="44dp">

        <!-- ── The header ─────────────────────────────────────────────────── -->
        <TextView
            style="@style/Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="@string/app_name" />

        <TextView
            style="@style/Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle"
            android:textColor="@color/ink_2" />

        <!-- ── Not connected ─────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/pane_connect"
            style="@style/Card.Base"
            android:layout_marginTop="26dp"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connect_title" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/connect_body"
                android:textColor="@color/ink_2" />

            <Button
                android:id="@+id/paste"
                style="@style/Button.Main"
                android:layout_width="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/connect_paste" />

            <include
                android:id="@+id/connect_problem"
                layout="@layout/notice"
                android:visibility="gone" />

            <TextView
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/connect_scope" />
        </LinearLayout>

        <!-- ── A connect link arrived ────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/pane_confirm"
            style="@style/Card.Base"
            android:layout_marginTop="26dp"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/confirm_title" />

            <TextView
                android:id="@+id/confirm_body"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink_2" />

            <CheckBox
                android:id="@+id/keep_copy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/accent_fill"
                android:fontFamily="@font/inter_medium"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:saveEnabled="false"
                android:text="@string/confirm_keep"
                android:textColor="@color/ink_1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/keep_note"
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="34dp"
                android:text="@string/confirm_keep_note" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/confirm_go"
                    style="@style/Button.Main"
                    android:layout_width="wrap_content"
                    android:text="@string/confirm_go" />

                <Button
                    android:id="@+id/confirm_cancel"
                    style="@style/Button.Quiet"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/confirm_cancel" />
            </LinearLayout>

            <include
                android:id="@+id/confirm_problem"
                layout="@layout/notice"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── Connected ─────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/pane_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- The buddy: its line for now and its note, each with two thumbs; "Tell your buddy";
                 what it said lately. Hidden while it is off or paused. -->
            <LinearLayout
                android:id="@+id/buddy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    style="@style/Card.Base"
                    android:layout_marginTop="24dp"
                    android:paddingStart="20dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/dot_accent" />

                        <TextView
                            android:id="@+id/buddy_title"
                            style="@style/Text.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/buddy_title" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/line_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/buddy_line"
                            style="@style/Text.Line"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textIsSelectable="true" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/line_more"
                                style="@style/Thumb"
                                android:contentDescription="@string/more_like_this"
                                android:src="@drawable/ic_thumb_up" />

                            <ImageButton
                                android:id="@+id/line_less"
                                style="@style/Thumb"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@string/not_this"
                                android:src="@drawable/ic_thumb_down" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/buddy_empty"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/ink_2"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/note_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/rule" />

                        <TextView
                            android:id="@+id/buddy_note"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textColor="@color/ink_2"
                            android:textIsSelectable="true" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/note_more"
                                style="@style/Thumb"
                                android:contentDescription="@string/more_like_this"
                                android:src="@drawable/ic_thumb_up" />

                            <ImageButton
                                android:id="@+id/note_less"
                                style="@style/Thumb"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@string/not_this"
                                android:src="@drawable/ic_thumb_down" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/tell"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input"
                            android:fontFamily="@font/inter_regular"
                            android:hint="@string/tell_hint"
                            android:imeOptions="actionSend"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="1000"
                            android:maxLines="4"
                            android:minHeight="46dp"
                            android:paddingStart="18dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp"
                            android:saveEnabled="false"
                            android:textColor="@color/ink_1"
                            android:textColorHint="@color/ink_3"
                            android:textSize="15sp" />

                        <ImageButton
                            android:id="@+id/tell_go"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_send"
                            android:contentDescription="@string/tell"
                            android:scaleType="center"
                            android:src="@drawable/ic_send" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/lately_title"
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="28dp"
                    android:text="@string/lately" />

                <LinearLayout
                    android:id="@+id/lately"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- The picture of the day as it is now, and the day in numbers. -->
            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="30dp"
                android:text="@string/your_picture" />

            <LinearLayout
                android:id="@+id/day_card"
                style="@style/Card.Base"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:id="@+id/preview_frame"
                    android:layout_width="104dp"
                    android:layout_height="225dp"
                    android:background="@drawable/bg_preview"
                    android:padding="1dp">

                    <ImageView
                        android:id="@+id/preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/preview_label"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="6dp">

                    <TextView
                        android:id="@+id/day_date"
                        style="@style/Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/day_headline"
                        style="@style/Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/day_lines"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/ink_2" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="12dp" />

                    <TextView
                        android:id="@+id/day_status"
                        style="@style/Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/refresh"
                        style="@style/Button.Small"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/refresh" />
                </LinearLayout>
            </LinearLayout>

            <include
                android:id="@+id/problem"
                layout="@layout/notice"
                android:visibility="gone" />

            <!-- The pictures' style: the server's styles as small pictures, then the chosen one's colours. -->
            <TextView
                android:id="@+id/style_title"
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="30dp"
                android:text="@string/style" />

            <HorizontalScrollView
                android:id="@+id/style_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="-18dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/style_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingEnd="18dp" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/color_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/style_note"
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="10dp" />

            <!-- Where it shows: the lock screen (a picture, or live with the phone's notification icons), the home screen. -->
            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="30dp"
                android:text="@string/show_on" />

            <LinearLayout
                style="@style/Card.Base"
                android:layout_marginTop="10dp"
                android:clipToOutline="true">

                <Switch
                    android:id="@+id/sw_lock"
                    style="@style/Row.Switch"
                    android:saveEnabled="false"
                    android:text="@string/lock_screen" />

                <LinearLayout
                    android:id="@+id/live_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View style="@style/Row.Rule" />

                    <Switch
                        android:id="@+id/sw_live"
                        style="@style/Row.Switch"
                        android:saveEnabled="false"
                        android:text="@string/live_switch" />

                    <TextView
                        android:id="@+id/live_note"
                        style="@style/Text.RowNote"
                        android:text="@string/live_note_off" />

                    <LinearLayout
                        android:id="@+id/live_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="18dp"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/live_access"
                            style="@style/Button.Small"
                            android:layout_width="wrap_content"
                            android:text="@string/live_allow" />

                        <Button
                            android:id="@+id/live_set"
                            style="@style/Button.Small"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/live_set" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/Row.Rule" />

                <Switch
                    android:id="@+id/sw_home"
                    style="@style/Row.Switch"
                    android:saveEnabled="false"
                    android:text="@string/home_screen" />
            </LinearLayout>

            <TextView
                android:id="@+id/show_on_note"
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="10dp"
                android:text="@string/show_on_note" />

            <Button
                android:id="@+id/add_widget"
                style="@style/Button.Small"
                android:layout_width="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/add_widget"
                android:visibility="gone" />

            <!-- The buddy's notes as notifications. -->
            <TextView
                android:id="@+id/notify_title"
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="30dp"
                android:text="@string/notify_section" />

            <LinearLayout
                style="@style/Card.Base"
                android:layout_marginTop="10dp"
                android:clipToOutline="true">

                <Switch
                    android:id="@+id/sw_notify"
                    style="@style/Row.Switch"
                    android:saveEnabled="false"
                    android:text="@string/notify" />

                <TextView
                    android:id="@+id/notify_note"
                    style="@style/Text.RowNote"
                    android:text="@string/notify_note" />

                <View style="@style/Row.Rule" />

                <!-- 0.5.0: reminders ring on this phone. -->
                <Switch
                    android:id="@+id/sw_reminders"
                    style="@style/Row.Switch"
                    android:saveEnabled="false"
                    android:text="@string/reminders_ring" />

                <TextView
                    style="@style/Text.RowNote"
                    android:text="@string/reminders_ring_note" />
            </LinearLayout>

            <!-- The look: theme, and the night. -->
            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="30dp"
                android:text="@string/theme" />

            <LinearLayout
                style="@style/Card.Base"
                android:layout_marginTop="10dp"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/theme_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segmented"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/theme_light"
                        style="@style/Segment"
                        android:text="@string/theme_light" />

                    <TextView
                        android:id="@+id/theme_dark"
                        style="@style/Segment"
                        android:text="@string/theme_dark" />

                    <TextView
                        android:id="@+id/theme_system"
                        style="@style/Segment"
                        android:text="@string/theme_system" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/theme_note" />
            </LinearLayout>

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="30dp"
                android:text="@string/at_night" />

            <LinearLayout
                style="@style/Card.Base"
                android:layout_marginTop="10dp"
                android:clipToOutline="true">

                <Switch
                    android:id="@+id/sw_quiet"
                    style="@style/Row.Switch"
                    android:saveEnabled="false"
                    android:text="@string/quiet_hours" />

                <LinearLayout
                    android:id="@+id/quiet_times"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="14dp">

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quiet_from"
                        android:textColor="@color/ink_2" />

                    <TextView
                        android:id="@+id/quiet_from"
                        style="@style/Chip.Time"
                        android:layout_marginStart="10dp" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/quiet_to"
                        android:textColor="@color/ink_2" />

                    <TextView
                        android:id="@+id/quiet_to"
                        style="@style/Chip.Time"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <TextView
                    style="@style/Text.RowNote"
                    android:layout_marginTop="0dp"
                    android:text="@string/quiet_note" />
            </LinearLayout>

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="30dp"
                android:text="@string/privacy" />

            <LinearLayout
                style="@style/Card.Base"
                android:layout_marginTop="10dp"
                android:clipToOutline="true">

                <Switch
                    android:id="@+id/sw_titles"
                    style="@style/Row.Switch"
                    android:saveEnabled="false"
                    android:text="@string/hide_titles" />

                <TextView
                    style="@style/Text.RowNote"
                    android:text="@string/hide_titles_note" />
            </LinearLayout>

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="30dp"
                android:text="@string/connection" />

            <LinearLayout
                style="@style/Card.Base"
                android:layout_marginTop="10dp"
                android:padding="18dp">

                <TextView
                    android:id="@+id/conn_server"
                    style="@style/Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/conn_account"
                    style="@style/Text.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/open_app"
                        style="@style/Button.Small"
                        android:layout_width="wrap_content"
                        android:text="@string/open_recollect" />

                    <Button
                        android:id="@+id/disconnect"
                        style="@style/Button.Danger"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:minHeight="38dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/disconnect"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/realme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="30dp"
                    android:text="@string/realme_title" />

                <LinearLayout
                    style="@style/Card.Base"
                    android:layout_marginTop="10dp"
                    android:padding="18dp">

                    <TextView
                        style="@style/Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink_2"
                        android:text="@string/realme_magazine" />

                    <TextView
                        style="@style/Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/ink_2"
                        android:text="@string/realme_battery" />

                    <Button
                        android:id="@+id/app_info"
                        style="@style/Button.Small"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/open_app_info" />
                </LinearLayout>
            </LinearLayout>

            <!-- The QA app only: the widget as the launcher would draw it, at both sizes, and the live lock screen. -->
            <LinearLayout
                android:id="@+id/widget_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/version"
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center_horizontal" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
