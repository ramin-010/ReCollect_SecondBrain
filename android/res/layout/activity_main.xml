<?xml version="1.0" encoding="utf-8"?>
<!--
  The one screen (ANDROID_APP_SPEC "Settings"). Its job: see the picture of the day and choose where
  it shows. Three states share it: not connected, a connect link arrived, connected.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/Text.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle"
            android:textColor="@color/ink_2" />

        <!-- ── Not connected ─────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/pane_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connect_title" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/connect_body" />

            <Button
                android:id="@+id/paste"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/connect_paste" />

            <include
                android:id="@+id/connect_problem"
                layout="@layout/notice"
                android:visibility="gone" />

            <TextView
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/connect_scope" />
        </LinearLayout>

        <!-- ── A connect link arrived ────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/pane_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/confirm_title" />

            <TextView
                android:id="@+id/confirm_body"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <CheckBox
                android:id="@+id/keep_copy"
                android:saveEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/accent_fill"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:text="@string/confirm_keep"
                android:textColor="@color/ink_1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/keep_note"
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="34dp"
                android:text="@string/confirm_keep_note" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/confirm_go"
                    style="@style/Button.Main"
                    android:layout_width="wrap_content"
                    android:text="@string/confirm_go" />

                <Button
                    android:id="@+id/confirm_cancel"
                    style="@style/Button.Quiet"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/confirm_cancel" />
            </LinearLayout>

            <include
                android:id="@+id/confirm_problem"
                layout="@layout/notice"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── Connected ─────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/pane_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- The buddy (0.3.0): its line for now and its note, each with two thumbs; "Tell your
                 buddy"; what it said lately. Hidden while it is off or paused. -->
            <LinearLayout
                android:id="@+id/buddy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/buddy_title"
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buddy_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:id="@+id/line_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/buddy_line"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:lineSpacingMultiplier="1.25"
                            android:textColor="@color/ink_1"
                            android:textIsSelectable="true"
                            android:textSize="17sp" />

                        <ImageButton
                            android:id="@+id/line_more"
                            style="@style/Thumb"
                            android:contentDescription="@string/more_like_this"
                            android:src="@drawable/ic_thumb_up" />

                        <ImageButton
                            android:id="@+id/line_less"
                            style="@style/Thumb"
                            android:contentDescription="@string/not_this"
                            android:src="@drawable/ic_thumb_down" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/buddy_empty"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp"
                        android:textColor="@color/ink_2"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/note_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/rule" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/buddy_note"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:lineSpacingMultiplier="1.3"
                                android:textColor="@color/ink_2"
                                android:textIsSelectable="true"
                                android:textSize="15sp" />

                            <ImageButton
                                android:id="@+id/note_more"
                                style="@style/Thumb"
                                android:contentDescription="@string/more_like_this"
                                android:src="@drawable/ic_thumb_up" />

                            <ImageButton
                                android:id="@+id/note_less"
                                style="@style/Thumb"
                                android:contentDescription="@string/not_this"
                                android:src="@drawable/ic_thumb_down" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/tell"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input"
                            android:hint="@string/tell_hint"
                            android:imeOptions="actionSend"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="1000"
                            android:maxLines="4"
                            android:minHeight="44dp"
                            android:paddingStart="12dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp"
                            android:saveEnabled="false"
                            android:textColor="@color/ink_1"
                            android:textColorHint="@color/ink_3"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/tell_go"
                            style="@style/Button.Main"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/tell" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/lately_title"
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/lately" />

                <LinearLayout
                    android:id="@+id/lately"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- The day: the picture as it is now, and its lines. -->
            <LinearLayout
                android:id="@+id/day_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:orientation="horizontal"
                android:padding="12dp">

                <FrameLayout
                    android:id="@+id/preview_frame"
                    android:layout_width="84dp"
                    android:layout_height="182dp"
                    android:background="@drawable/bg_preview"
                    android:padding="1dp">

                    <ImageView
                        android:id="@+id/preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/preview_label"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/day_date"
                        style="@style/Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/day_headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="@color/ink_1"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/day_lines"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.25"
                        android:textColor="@color/ink_2"
                        android:textSize="14sp" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="8dp" />

                    <TextView
                        android:id="@+id/day_status"
                        style="@style/Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/refresh"
                        style="@style/Button.Outline"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:minHeight="40dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/refresh" />
                </LinearLayout>
            </LinearLayout>

            <include
                android:id="@+id/problem"
                layout="@layout/notice"
                android:visibility="gone" />

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/show_on" />

            <Switch
                android:id="@+id/sw_lock"
                android:saveEnabled="false"
                style="@style/Row.Switch"
                android:layout_marginStart="-8dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="-8dp"
                android:text="@string/lock_screen" />

            <Switch
                android:id="@+id/sw_home"
                android:saveEnabled="false"
                style="@style/Row.Switch"
                android:layout_marginStart="-8dp"
                android:layout_marginEnd="-8dp"
                android:text="@string/home_screen" />

            <TextView
                android:id="@+id/show_on_note"
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/show_on_note" />

            <Button
                android:id="@+id/add_widget"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:minHeight="40dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/add_widget"
                android:visibility="gone" />

            <!-- The pictures' style (0.3.0): the server's styles as small pictures, then the chosen one's colours. -->
            <TextView
                android:id="@+id/style_title"
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/style" />

            <HorizontalScrollView
                android:id="@+id/style_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="-16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/style_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingEnd="16dp" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/color_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/style_note"
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- The buddy's notes as notifications (0.3.0). -->
            <TextView
                android:id="@+id/notify_title"
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/notify_section" />

            <Switch
                android:id="@+id/sw_notify"
                android:saveEnabled="false"
                style="@style/Row.Switch"
                android:layout_marginStart="-8dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="-8dp"
                android:text="@string/notify" />

            <TextView
                android:id="@+id/notify_note"
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/notify_note" />

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/theme" />

            <LinearLayout
                android:id="@+id/theme_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_segmented"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/theme_light"
                    style="@style/Segment"
                    android:text="@string/theme_light" />

                <TextView
                    android:id="@+id/theme_dark"
                    style="@style/Segment"
                    android:text="@string/theme_dark" />

                <TextView
                    android:id="@+id/theme_system"
                    style="@style/Segment"
                    android:text="@string/theme_system" />
            </LinearLayout>

            <TextView
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/theme_note" />

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/at_night" />

            <Switch
                android:id="@+id/sw_quiet"
                android:saveEnabled="false"
                style="@style/Row.Switch"
                android:layout_marginStart="-8dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="-8dp"
                android:text="@string/quiet_hours" />

            <LinearLayout
                android:id="@+id/quiet_times"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quiet_from"
                    android:textColor="@color/ink_2" />

                <TextView
                    android:id="@+id/quiet_from"
                    style="@style/Chip.Time"
                    android:layout_marginStart="8dp" />

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/quiet_to"
                    android:textColor="@color/ink_2" />

                <TextView
                    android:id="@+id/quiet_to"
                    style="@style/Chip.Time"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/quiet_note" />

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/privacy" />

            <Switch
                android:id="@+id/sw_titles"
                android:saveEnabled="false"
                style="@style/Row.Switch"
                android:layout_marginStart="-8dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="-8dp"
                android:text="@string/hide_titles" />

            <TextView
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/hide_titles_note" />

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/connection" />

            <TextView
                android:id="@+id/conn_server"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/conn_account"
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/open_app"
                    style="@style/Button.Outline"
                    android:layout_width="wrap_content"
                    android:text="@string/open_recollect" />

                <Button
                    android:id="@+id/disconnect"
                    style="@style/Button.Danger"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/disconnect" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/realme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/realme_title" />

                <TextView
                    style="@style/Text.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/realme_magazine" />

                <TextView
                    style="@style/Text.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/realme_battery" />

                <Button
                    android:id="@+id/app_info"
                    style="@style/Button.Outline"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:minHeight="40dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/open_app_info" />
            </LinearLayout>

            <!-- The QA app only: the widget as the launcher would draw it, at both sizes. -->
            <LinearLayout
                android:id="@+id/widget_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/version"
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
