<?xml version="1.0" encoding="utf-8"?>
<!--
  "Your day", 4 x 2: the date, the one line that matters now, up to three quieter lines. Plain type on
  the theme's surface (DESIGN.md); no counts as a headline, no streaks, never red. Long lines fade at
  the edge instead of "…" (as the web app's sidebar does).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/w_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="none"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="24dp"
        android:textColor="@color/w_ink_3"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:lineSpacingMultiplier="1.1"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/w_ink_1"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/w_line1"
        style="@style/WidgetLine"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/w_line2"
        style="@style/WidgetLine" />

    <TextView
        android:id="@+id/w_line3"
        style="@style/WidgetLine" />

    <TextView
        android:id="@+id/w_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:textColor="@color/w_ink_3"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
