<?xml version="1.0" encoding="utf-8"?>
<!--
  "Your day", 4 x 1 (0.7.0, stage 19): the card's label and title only (no button: a tap opens the item); with
  nothing ahead, the date and the buddy's line (in the serif) or the day's words. Same ids as widget_day.xml.
  Edit this file, then run `python widget-themes.py` in android/ for the light, dark and Paper copies.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/w_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="none"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="24dp"
        android:textColor="@color/w_ink_3"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:singleLine="true"
        android:ellipsize="none"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="24dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/w_ink_1"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/w_voice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:singleLine="true"
        android:ellipsize="none"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="24dp"
        android:fontFamily="serif"
        android:textColor="@color/w_ink_1"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
