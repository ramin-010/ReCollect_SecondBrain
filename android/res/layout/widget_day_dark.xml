<?xml version="1.0" encoding="utf-8"?>
<!-- Made from widget_day.xml with the dark steps by widget-themes.py: edit widget_day.xml, then run it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/w_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:singleLine="true"
        android:ellipsize="none"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="24dp"
        android:textColor="@color/w_dark_ink_3"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.1"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/w_dark_ink_1"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_numbers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="none"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="24dp"
            android:textColor="@color/w_dark_ink_2"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/w_more"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/more_like_this"
            android:padding="9dp"
            android:src="@drawable/ic_thumb_up"
            android:tint="@color/w_dark_ink_2"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/w_less"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/not_this"
            android:padding="9dp"
            android:src="@drawable/ic_thumb_down"
            android:tint="@color/w_dark_ink_2"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textColor="@color/w_dark_ink_3"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
