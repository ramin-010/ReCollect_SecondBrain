<?xml version="1.0" encoding="utf-8"?>
<resources>
    <bool name="light_bars">true</bool>

    <!-- The platform's Material theme (no AndroidX) on the app's tokens, Inter throughout (0.4.0). values-night swaps the parent. -->
    <style name="Base.Recollect" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:colorPrimary">@color/page</item>
        <item name="android:colorPrimaryDark">@color/page</item>
        <item name="android:colorAccent">@color/accent_fill</item>
        <item name="android:colorControlNormal">@color/icon</item>
        <item name="android:colorControlActivated">@color/accent_fill</item>
        <item name="android:colorControlHighlight">@color/press</item>
        <item name="android:textColorPrimary">@color/ink_1</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
        <item name="android:textColorHint">@color/ink_3</item>
        <item name="android:textColorHighlight">@color/accent_soft</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:alertDialogTheme">@style/Dialog.Recollect</item>
        <item name="android:timePickerDialogTheme">@style/Dialog.Recollect</item>
    </style>

    <style name="Theme.Recollect" parent="Base.Recollect" />

    <!-- The shell (0.7.0): no preview window, so the first frame is the look's own ground, never another colour. -->
    <style name="Theme.Recollect.Shell" parent="Theme.Recollect">
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Dialog.Recollect" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
        <item name="android:textColorPrimary">@color/ink_1</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <!-- Dialog buttons in sentence case (no all-caps labels). -->
    <style name="DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
