<?xml version="1.0" encoding="utf-8"?>
<resources>
    <bool name="light_bars">true</bool>

    <!-- The platform's Material theme (no AndroidX) on the app's tokens, Inter throughout (0.4.0). values-night swaps the parent. -->
    <style name="Base.Recollect" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:colorPrimary">@color/page</item>
        <item name="android:colorPrimaryDark">@color/page</item>
        <item name="android:colorAccent">@color/accent_fill</item>
        <item name="android:colorControlNormal">@color/icon</item>
        <item name="android:colorControlActivated">@color/accent_fill</item>
        <item name="android:colorControlHighlight">@color/press</item>
        <item name="android:textColorPrimary">@color/ink_1</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
        <item name="android:textColorHint">@color/ink_3</item>
        <item name="android:textColorHighlight">@color/accent_soft</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:alertDialogTheme">@style/Dialog.Recollect</item>
        <item name="android:timePickerDialogTheme">@style/Dialog.Recollect</item>
    </style>

    <style name="Theme.Recollect" parent="Base.Recollect" />

    <style name="Dialog.Recollect" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
        <item name="android:textColorPrimary">@color/ink_1</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <!-- Dialog buttons in sentence case (no all-caps labels). -->
    <style name="DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Roots for the dotted names below (a dotted style inherits from its prefix). -->
    <style name="Text" />
    <style name="Row" />
    <style name="Button" />
    <style name="Chip" />
    <style name="Card" />

    <!-- Type (0.4.0): Inter as on the pictures. Display 30 / title 21 / the buddy's line 19 / label 16 /
         body 15 / section and meta 13. Tight tracking on the large sizes, none on small text. -->
    <style name="Text.Display">
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/ink_1</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>
    <style name="Text.Heading" parent="Text.Display" />
    <style name="Text.Title">
        <item name="android:textSize">21sp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/ink_1</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:lineSpacingMultiplier">1.12</item>
    </style>
    <style name="Text.Line">
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/ink_1</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.28</item>
    </style>
    <style name="Text.Label">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/ink_1</item>
    </style>
    <style name="Text.Section">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/ink_1</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>
    <style name="Text.Meta">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/ink_3</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- A card: 22 dp corners, a hairline ring, its own padding. -->
    <style name="Card.Base">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- A row with a switch inside a card: 58 dp, its words as a label. -->
    <style name="Row.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/ink_1</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:switchMinWidth">46dp</item>
        <item name="android:switchPadding">16dp</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <!-- The words under a row, inside its card. -->
    <style name="Text.RowNote" parent="Text.Meta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:layout_marginTop">-6dp</item>
    </style>
    <style name="Row.Rule">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">18dp</item>
        <item name="android:background">@color/line</item>
    </style>

    <!-- Buttons: pills. Main (ink), soft (a filled step), quiet (words only). -->
    <style name="Button.Base">
        <item name="android:layout_height">46dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Button.Main" parent="Button.Base">
        <item name="android:background">@drawable/bg_button_main</item>
        <item name="android:textColor">@color/on_main</item>
    </style>
    <style name="Button.Outline" parent="Button.Base">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/ink_1</item>
    </style>
    <style name="Button.Small" parent="Button.Outline">
        <item name="android:layout_height">38dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Button.Quiet" parent="Button.Base">
        <item name="android:background">@drawable/bg_button_quiet</item>
        <item name="android:textColor">@color/ink_2</item>
    </style>
    <style name="Button.Danger" parent="Button.Quiet">
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="Segment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:background">@drawable/bg_segment</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="WidgetLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">none</item>
        <item name="android:requiresFadingEdge">horizontal</item>
        <item name="android:fadingEdgeLength">24dp</item>
        <item name="android:textColor">@color/w_ink_2</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- A thumb: a 36 dp round button, the icon 18 dp; the given one on the accent's soft fill. -->
    <style name="Thumb">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/bg_thumb</item>
        <item name="android:tint">@color/thumb_tint</item>
    </style>

    <style name="Chip.Time">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/ink_1</item>
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
