<?xml version="1.0" encoding="utf-8"?>
<!--
  Kaaga's phone app (context/specs/ANDROID_APP_SPEC.md; named Kaaga since 0.8.0, its package id kept): the picture of the day as the home and
  lock screen wallpaper, a home-screen widget with the same lines, and one settings screen. It reads
  two things from the server with its own narrow token (the `ambient` scope) and nothing else.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.recollect.phone">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Persisted refresh jobs come back after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The buddy's notes (0.3.0); asked on Android 13 and newer when he turns them on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Stage 11 (his item 10c): reminders on the minute from Android 12; the person allows it from the checklist. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 0.7.5: a reminder that rings is a real alarm: a full-screen alarm with looping sound and vibration (AlarmService). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Only to keep a copy of the wallpaper he had, so Disconnect can put it back (Android 12 and older; asked when he ticks it). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- The live lock screen (0.4.1) draws each app's own icon: Android 11+ lets the app see the launchable apps' icons. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The shell's mic (0.7.0): Android's own speech recognizer, when the phone has one. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic: before the deploy the server is this computer over USB or the hotspot (http);
         ConnectLink refuses plain http for anything but a local address. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Recollect"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <!-- The app (0.7.3, the owner 11-22: no old screen left): the web app's phone world (/m/...) in a WebView, with
             the phone's own parts through a bridge. The launcher, the share target (a text opens the chat with it), and
             the connect link the server's /phone/connect page opens (recollect://connect?server=...&token=...). -->
        <activity
            android:name=".Shell"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Recollect.Shell"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="recollect" android:host="connect" />
            </intent-filter>
        </activity>

        <service
            android:name=".RefreshJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".DayWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/day_widget" />
        </receiver>

        <!-- 0.4.0, the live lock screen: the pictures drawn by the app, with the notification icons. -->
        <service
            android:name=".DayWallpaper"
            android:exported="true"
            android:label="@string/live_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- Which apps have notifications waiting (their icons only), once he allows it. -->
        <service
            android:name=".NotifIcons"
            android:exported="true"
            android:label="@string/notif_icons_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 0.6.0: a question's quick answer or reply from its notification, and the alarm that switches a
             picture to its plain twin at an end time or quiet hours (both sent only by the app itself). -->
        <receiver
            android:name=".Asks"
            android:exported="false" />
        <receiver
            android:name=".Pictures"
            android:exported="false" />

        <!-- 0.5.0: a reminder's alarm (set by the app itself; nothing outside may send it). -->
        <receiver
            android:name=".ReminderAlarm"
            android:exported="false" />

        <!-- 0.7.5: the ringing alarm (sound, vibration, the full-screen screen with Snooze and Dismiss). -->
        <service
            android:name=".AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Recollect" />

        <receiver
            android:name=".Wake"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
